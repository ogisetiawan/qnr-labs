---
import '../styles/global.css';
import SEOHead from '@components/SEOHead.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
}

const { title, description, image = '/og.png', canonical } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEOHead title={title} description={description} image={image} canonical={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
