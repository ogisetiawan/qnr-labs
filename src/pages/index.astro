---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import SelectedWork from '@components/SelectedWork.astro';
import SiteFooter from '@components/SiteFooter.astro';
import SiteHeader from '@components/SiteHeader.astro';
import SkipLink from '@components/ui/SkipLink.astro';

const description = 'Building useful software, tools, and digital solutions.';

const work = [
  {
    title: 'Account Switcher',
    category: 'Extension',
    status: 'Released',
    summary: '[TBD — short description]',
    highlight: '100+ installs',
    install: '[TBD]',
    date: '[TBD]',
  },
];
---

<BaseLayout title="QNR Labs" description={description}>
  <SkipLink />
  <SiteHeader />
  <main id="content">
    <Hero title={description} />
    <SelectedWork projects={work} />
  </main>
  <SiteFooter />
</BaseLayout>
