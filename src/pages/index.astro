---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import Process from '@components/Process.astro';
import DigitalLabs from '@components/DigitalLabs.astro';
import Services from '@components/Services.astro';
import OpenSource from '@components/OpenSource.astro';
import Contact from '@components/Contact.astro';
import SiteFooter from '@components/SiteFooter.astro';
import SiteHeader from '@components/SiteHeader.astro';
import SkipLink from '@components/ui/SkipLink.astro';
import { labProjects } from '../data/labs';

const heroTitle = 'Built from real problems. Made for everyone';
const heroLede = 'Turning real problems into useful digital products. Shared with everyone who can benefit from them.';
const description = heroLede;
---

<BaseLayout title="QNR Labs" description={description}>
  <SkipLink />
  <SiteHeader />
  <main id="content">
    <Hero title={heroTitle} lede={heroLede} />
    <Process />
    <DigitalLabs projects={labProjects} />
    <Services />
    <OpenSource />
    <Contact />
  </main>
  <SiteFooter />
</BaseLayout>