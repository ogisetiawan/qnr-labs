---
import Container from './ui/Container.astro';
import HeroArt from './HeroArt.astro';

interface Channel {
  label: string;
  value: string;
  href?: string;
}

interface Props {
  id?: string;
  title?: string;
  lede?: string;
  channels?: Channel[];
}

const {
  id = 'contact',
  title = 'Contact QNR Labs',
  lede = 'Ask QNR to build something or reach out through a public channel. No contact form on this site.',
  channels = [
    { label: 'Email', value: '[TBD]' },
    { label: 'GitHub', value: '[TBD]' },
  ],
} = Astro.props;

const titleId = `${id}-title`;
---

<section id={id} class="section" aria-labelledby={titleId}>
  <Container>
    <div class="layout">
      <div class="copy">
        <h2 id={titleId}>{title}</h2>
        <p class="lede">{lede}</p>
        <ul class="channels" aria-label="Contact channels">
          {
            channels.map((channel) => (
              <li>
                {channel.href ? (
                  <a href={channel.href}>
                    <span class="label">{channel.label}</span>
                    <span class="value">{channel.value}</span>
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                ) : (
                  <span class="channel">
                    <span class="label">{channel.label}</span>
                    <span class="value">{channel.value}</span>
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="art">
        <HeroArt side="left" class="piece" />
        <HeroArt side="right" class="piece" />
      </div>
    </div>
  </Container>
</section>

<style>
  .section {
    padding-block: 80px;
    scroll-margin-top: 104px;
  }

  .layout {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  h2 {
    margin: 0;
    color: var(--color-ink-black);
    font-size: var(--text-heading-lg);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-heading-lg);
    letter-spacing: var(--tracking-heading-lg);
    text-wrap: balance;
  }

  .lede {
    margin: 20px 0 0;
    max-width: 36ch;
    color: var(--color-body-brown);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
    text-wrap: pretty;
  }

  .channels {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .channels li {
    padding-block: 16px;
    box-shadow: inset 0 -1px 0 var(--color-stone-border);
  }

  .channels li:first-child {
    box-shadow:
      inset 0 1px 0 var(--color-stone-border),
      inset 0 -1px 0 var(--color-stone-border);
  }

  a,
  .channel {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    width: 100%;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
  }

  a {
    color: var(--color-link-blue);
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  a:focus-visible {
    outline: 2px solid var(--color-ember-orange);
    outline-offset: 2px;
  }

  .channel {
    color: var(--color-ink-black);
  }

  .label {
    font-weight: var(--font-weight-medium);
    color: var(--color-heading-charcoal);
  }

  .value {
    color: var(--color-body-brown);
  }

  .art {
    display: flex;
    justify-content: center;
    gap: 8px;
    min-width: 0;
  }

  .art :global(.piece) {
    width: min(42vw, 168px);
    height: auto;
  }

  @media (min-width: 900px) {
    .section {
      padding-block: 104px;
    }

    .layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 64px;
    }

    .art {
      justify-content: flex-end;
    }

    .art :global(.piece) {
      width: min(100%, 220px);
    }
  }
</style>
