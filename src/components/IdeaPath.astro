---
const steps = [
  {
    n: '1',
    tone: 'sky',
    title: 'Notice',
    text: 'A problem of my own.',
  },
  {
    n: '2',
    tone: 'honey',
    title: 'Close',
    text: 'Or someone nearby.',
  },
  {
    n: '3',
    tone: 'mint',
    title: 'Shape',
    text: 'Turn it into a clear idea.',
  },
  {
    n: '4',
    tone: 'plum',
    title: 'Build',
    text: 'Make a small version.',
  },
];

const path = ['Idea', 'Build', 'Released'];
---

<section class="idea-path" aria-labelledby="idea-path-title">
  <h2 id="idea-path-title" class="summary">How an idea becomes a product</h2>
  <div class="bento">
    <article class="cell span">
      <div class="panel dark">
        <ol>
          {
            steps.map((step) => (
              <li>
                <span class:list={['num', step.tone]}>{step.n}</span>
                <span>
                  <strong>{step.title}</strong>
                  <span>{step.text}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <h3>From a problem</h3>
      <p>QNR starts with a real problem, then keeps the first version small enough to build.</p>
    </article>

    <article class="cell">
      <div class="panel center">
        <span class="ship">Ship it</span>
      </div>
      <h3>Ship</h3>
      <p>The small version leaves as a product, not a note.</p>
    </article>

    <article class="cell">
      <div class="panel">
        <ol class="path">
          {
            path.map((item, index) => (
              <li class:list={[index === path.length - 1 && 'current']}>
                <span class="node" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <h3>In order</h3>
      <p>The same path, from the idea to a released product.</p>
    </article>

    <article class="cell">
      <div class="panel center">
        <p class="released">
          <span class="live" aria-hidden="true"></span>
          Released
        </p>
      </div>
      <h3>Release</h3>
      <p>Released work is listed in Digital Labs.</p>
    </article>

    <article class="cell">
      <div class="panel center">
        <ul class="marks">
          <li><span class="disc problem">Problem</span></li>
          <li><span class="disc product">Product</span></li>
          <li><span class="disc others">Others</span></li>
        </ul>
      </div>
      <h3>Shared</h3>
      <p>A fix for the founder can become a tool other people use.</p>
    </article>
  </div>
</section>

<style>
  .idea-path {
    position: relative;
    padding: 28px 16px 80px;
  }

  .summary {
    width: min(100%, var(--page-max-width));
    margin: 0 auto 28px;
    color: var(--color-ink-black);
    font-size: var(--text-heading-lg);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-heading-lg);
    letter-spacing: var(--tracking-heading-lg);
    text-align: center;
  }

  .bento {
    display: grid;
    gap: 36px 12px;
    width: min(100%, var(--page-max-width));
    margin-inline: auto;
  }

  .cell h3 {
    margin: 16px 0 0;
    color: var(--color-ink-black);
    font-size: var(--text-heading);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .cell p {
    margin: 8px 0 0;
    max-width: 32ch;
    color: var(--color-body-brown);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
  }

  .panel {
    padding: 16px;
    background: var(--surface-pure-white);
    border-radius: var(--radius-3xl);
    box-shadow: var(--shadow-subtle);
  }

  .dark {
    padding: 8px;
    background: var(--surface-full-black);
    color: var(--color-cream-canvas);
  }

  .dark ol,
  .path,
  .marks {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dark li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 12px;
  }

  .dark li + li {
    box-shadow: inset 0 1px 0 rgba(251, 250, 249, 0.12);
  }

  .dark strong,
  .dark span span {
    display: block;
  }

  .dark strong {
    font-size: 15px;
    font-weight: var(--font-weight-semibold);
    line-height: 22px;
  }

  .dark li span span {
    color: var(--color-stone-surface);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
  }

  .num {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-pills);
    color: var(--color-ink-black);
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
  }

  .sky {
    background: var(--color-sky-blue);
  }

  .honey {
    background: var(--color-honey);
  }

  .mint {
    background: var(--color-mint);
  }

  .plum {
    background: var(--color-plum-violet);
    color: var(--color-cream-canvas);
  }

  .center {
    display: grid;
    min-height: 148px;
    place-items: center;
  }

  .ship {
    padding: 12px 22px;
    border-radius: var(--radius-buttons);
    background: var(--surface-dark-surface);
    color: var(--color-cream-canvas);
    font-size: 16px;
    font-weight: var(--font-weight-semibold);
    line-height: 22px;
  }

  .path {
    display: grid;
    gap: 0;
  }

  .path li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 12px;
    align-items: center;
    color: var(--color-muted-gray);
    font-size: var(--text-body);
    line-height: 40px;
  }

  .path li.current {
    color: var(--color-ink-black);
    font-weight: var(--font-weight-medium);
  }

  .node {
    position: relative;
    width: 10px;
    height: 10px;
    margin-inline: auto;
    border: 2px solid var(--color-stone-border);
    border-radius: var(--radius-pills);
    background: var(--surface-pure-white);
  }

  .path li:not(:last-child) .node::after {
    content: '';
    position: absolute;
    top: 10px;
    left: 3px;
    width: 2px;
    height: 30px;
    background: var(--color-stone-border);
  }

  .path li.current .node {
    border-color: var(--color-ink-black);
    background: var(--color-ink-black);
  }

  .released {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--color-ink-black);
    font-size: var(--text-heading);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .live {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-pills);
    background: var(--color-mint);
  }

  .marks {
    display: flex;
    gap: 12px;
  }

  .disc {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: var(--radius-pills);
    color: var(--color-ink-black);
    font-size: 12px;
    font-weight: var(--font-weight-semibold);
    line-height: 16px;
    text-align: center;
  }

  .problem {
    background: var(--color-honey);
  }

  .product {
    background: var(--color-sky-blue);
  }

  .others {
    background: var(--color-mint);
  }

  @media (min-width: 900px) {
    .idea-path {
      padding-block: 36px 104px;
    }

    .bento {
      grid-template-columns: 1.15fr 1fr 1fr;
      gap: 28px 16px;
      align-items: stretch;
    }

    .span {
      display: flex;
      flex-direction: column;
      grid-row: span 2;
    }

    .span .panel {
      flex: 1;
    }
  }
</style>
