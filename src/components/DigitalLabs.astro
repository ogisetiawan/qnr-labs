---
import Container from './ui/Container.astro';
import Pill from './ui/Pill.astro';
import type { LabProject } from '../data/labs';

interface Props {
  projects: LabProject[];
  id?: string;
  title?: string;
  href?: string;
  action?: string;
}

const {
  projects,
  id = 'labs',
  title = 'Released work, in one place.',
  href = '/labs',
  action = 'View projects',
} = Astro.props;

const featured =
  projects.find((project) => project.status === 'Released') ?? projects[0];

const isConfirmedUrl = (value: string) =>
  value.trim().length > 0 && !value.trim().startsWith('[TBD');

const titleId = `${id}-title`;
const problemId = featured ? `${id}-problem` : undefined;
const solutionId = featured ? `${id}-solution` : undefined;
---

<section id={id} class="section" aria-labelledby={titleId}>
  <Container>
    <div class="layout">
      <div class="section-head">
        <p class="eyebrow">Digital Labs</p>
        <h2 id={titleId}>{title}</h2>
        <Pill href={href}>{action}</Pill>
      </div>

      {
        featured ? (
          <article class="spotlight" aria-labelledby={`${id}-project-title`}>
            <div
              class="shot"
              role="img"
              aria-label="[TBD] Screenshot"
            >
              <span>[TBD] Screenshot</span>
            </div>

            <div class="spotlight-head">
              <h3 id={`${id}-project-title`}>{featured.title}</h3>
              <span class="status">{featured.status}</span>
            </div>

            <p class="highlight">
              <span class="highlight-label">Verified highlight</span>
              {featured.highlight}
            </p>

            <div class="zone">
              <p class="zone-label">Product description</p>
              <p class="zone-body">{featured.summary}</p>
            </div>

            <div class="zone">
              <h4 id={problemId} class="zone-label">
                The Problem
              </h4>
              <p class="zone-body" aria-labelledby={problemId}>
                [TBD — problem story]
              </p>
            </div>

            <div class="zone">
              <h4 id={solutionId} class="zone-label">
                The Solution
              </h4>
              <p class="zone-body" aria-labelledby={solutionId}>
                [TBD — solution story]
              </p>
            </div>

            <div class="zone">
              <p class="zone-label">Project details</p>
              <dl class="rows">
                <div>
                  <dt>Category</dt>
                  <dd>[TBD]</dd>
                </div>
                <div>
                  <dt>Technology</dt>
                  <dd>[TBD]</dd>
                </div>
                <div>
                  <dt>License</dt>
                  <dd>[TBD]</dd>
                </div>
              </dl>
            </div>

            <dl class="rows">
              <div>
                <dt>Live demo</dt>
                <dd>
                  {isConfirmedUrl(featured.install) ? (
                    <a href={featured.install}>Install</a>
                  ) : (
                    featured.install
                  )}
                </dd>
              </div>
              <div>
                <dt>GitHub</dt>
                <dd>[TBD]</dd>
              </div>
              <div>
                <dt>Release date</dt>
                <dd>{featured.date}</dd>
              </div>
            </dl>
          </article>
        ) : null
      }
    </div>
  </Container>
</section>

<style>
  .section {
    padding-block: 80px;
    scroll-margin-top: 104px;
  }

  .layout {
    display: grid;
    gap: 40px;
  }

  .section-head {
    max-width: 28rem;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-muted-gray);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0 0 28px;
    color: var(--color-ink-black);
    font-size: var(--text-heading-lg);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-heading-lg);
    letter-spacing: var(--tracking-heading-lg);
  }

  .spotlight {
    margin: 0;
    padding: var(--card-padding);
    background: var(--surface-pure-white);
    border-radius: var(--radius-cards);
    box-shadow: var(--shadow-subtle);
  }

  .shot {
    display: grid;
    place-items: center;
    min-height: 200px;
    margin-bottom: 28px;
    background: var(--color-cream-canvas);
    border-radius: var(--radius-cards);
    box-shadow: inset 0 0 0 1px var(--color-stone-surface);
    color: var(--color-body-brown);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
  }

  .spotlight-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-bottom: 16px;
  }

  h3 {
    margin: 0;
    color: var(--color-heading-charcoal);
    font-size: var(--text-heading);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .status {
    padding: 4px 12px;
    border-radius: var(--radius-badges);
    background: var(--surface-sand);
    color: var(--color-heading-charcoal);
    font-size: var(--text-micro);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-micro);
  }

  .highlight {
    display: grid;
    gap: 4px;
    margin: 0 0 24px;
    padding: 16px 20px;
    background: var(--color-stone-surface);
    border-radius: var(--radius-md);
    color: var(--color-body-brown);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .highlight-label,
  .zone-label {
    margin: 0;
    color: var(--color-muted-gray);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .zone {
    margin-bottom: 24px;
  }

  .zone .zone-label {
    margin-bottom: 8px;
  }

  .zone-body {
    margin: 0;
    color: var(--color-body-brown);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
  }

  .rows {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .rows div {
    display: grid;
    grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding-block: 14px;
    box-shadow: inset 0 -1px 0 var(--color-stone-surface);
  }

  .rows div:first-child {
    box-shadow:
      inset 0 1px 0 var(--color-stone-surface),
      inset 0 -1px 0 var(--color-stone-surface);
  }

  .rows dt {
    margin: 0;
    color: var(--color-heading-charcoal);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-caption);
  }

  .rows dd {
    margin: 0;
    color: var(--color-body-brown);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .rows a {
    color: var(--color-link-blue);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .rows a:focus-visible {
    outline: 2px solid var(--color-ember-orange);
    outline-offset: 2px;
  }

  @media (min-width: 900px) {
    .section {
      padding-block: 104px;
    }

    .layout {
      gap: 48px;
    }
  }
</style>