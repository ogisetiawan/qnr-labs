---
import Container from './ui/Container.astro';
import Pill from './ui/Pill.astro';
import SectionLabel from './ui/SectionLabel.astro';
import type { LabProject } from '../data/labs';

interface Props {
  projects: LabProject[];
  id?: string;
  title?: string;
  title2?: string;
  href?: string;
  action?: string;
}

const {
  projects,
  id = 'labs',
  title = 'Released work,',
  title2 = ' in one place.',
  href = '/labs',
  action = 'View projects',
} = Astro.props;

const featured = projects.find((project) => project.status === 'Released') ?? projects[0];

const isConfirmedUrl = (value: string) =>
  value.trim().length > 0 && !value.trim().startsWith('[TBD');

const titleId = `${id}-title`;
const projectTitleId = `${id}-project-title`;
---

<section id={id} class="section" aria-labelledby={titleId}>
  <Container>
    <div class="section-head">
      <SectionLabel label="Digital Labs" />
      <h2 id={titleId}>{title}<span class="accent">{title2}</span></h2>
      <Pill href={href}>{action}</Pill>
    </div>

    {
      featured ? (
        <div class="feature">
          <div class="preview">
            <img src="/brand/mark.svg" alt="" width="120" height="108" />
            <p>[TBD] Screenshot</p>
          </div>

          <ul class="rows">
            <li>
              <span class="well">01</span>
              <div>
                <p class="label">Product description</p>
                <p class="sub">{featured.summary}</p>
              </div>
            </li>
            <li>
              <span class="well">02</span>
              <div>
                <p class="label">The Problem</p>
                <p class="sub">[TBD — problem story]</p>
              </div>
            </li>
            <li>
              <span class="well">03</span>
              <div>
                <p class="label">The Solution</p>
                <p class="sub">[TBD — solution story]</p>
              </div>
            </li>
            <li class="details">
              <span class="well">04</span>
              <div>
                <p class="label">Project details</p>
                <dl>
                  <div>
                    <dt>Category</dt>
                    <dd>[TBD]</dd>
                  </div>
                  <div>
                    <dt>Technology</dt>
                    <dd>[TBD]</dd>
                  </div>
                  <div>
                    <dt>License</dt>
                    <dd>[TBD]</dd>
                  </div>
                  <div>
                    <dt>Live demo</dt>
                    <dd>
                      {
                        isConfirmedUrl(featured.install) ? (
                          <a href={featured.install}>Install</a>
                        ) : (
                          featured.install
                        )
                      }
                    </dd>
                  </div>
                  <div>
                    <dt>GitHub</dt>
                    <dd>[TBD]</dd>
                  </div>
                  <div>
                    <dt>Release date</dt>
                    <dd>{featured.date}</dd>
                  </div>
                </dl>
              </div>
            </li>
            <li class="selected">
              <span class="well">
                <img src="/brand/mark.svg" alt="" width="22" height="20" />
              </span>
              <div>
                <h3 id={projectTitleId}>{featured.title}</h3>
                <p class="sub">
                  {featured.status}
                  {featured.highlight ? ` · ${featured.highlight}` : ''}
                </p>
              </div>
            </li>
          </ul>
        </div>
      ) : null
    }
  </Container>
</section>

<style>
  .section {
    padding-block: 80px;
    scroll-margin-top: 104px;
  }

  .section-head {
    max-width: 28rem;
    margin-inline: auto;
    margin-bottom: 40px;
    text-align: center;
  }

  h2 {
    margin: 0 0 28px;
    color: var(--color-ink-black);
    font-size: var(--text-heading-lg);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-heading-lg);
    letter-spacing: var(--tracking-heading-lg);
    text-wrap: balance;
  }

  .feature {
    display: grid;
    gap: 16px;
  }

  .preview {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 16px;
    min-height: 280px;
    padding: 32px;
    background: var(--color-stone-surface);
    border-radius: var(--radius-3xl);
  }

  .preview img {
    width: 120px;
    height: auto;
  }

  .preview p {
    margin: 0;
    color: var(--color-body-brown);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
  }

  .rows {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rows li {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    margin: 0;
    padding: 16px 18px;
    background: var(--surface-pure-white);
    border-radius: var(--radius-cards);
    box-shadow: var(--shadow-subtle);
  }

  .details {
    align-items: start;
  }

  .well {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--surface-sand);
    color: var(--color-ink-black);
    font-size: var(--text-micro);
    font-weight: var(--font-weight-semibold);
    line-height: 1;
  }

  .label,
  h3,
  .sub {
    margin: 0;
  }

  .label,
  h3 {
    color: var(--color-ink-black);
    font-size: var(--text-body);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
  }

  .sub {
    color: var(--color-body-brown);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    letter-spacing: var(--tracking-caption);
  }

  .selected {
    align-items: center;
    background: var(--surface-dark-surface);
    box-shadow: none;
  }

  .selected .well {
    background: var(--surface-pure-white);
  }

  .selected .well img {
    width: 22px;
    height: auto;
  }

  .selected h3,
  .selected .sub {
    color: var(--color-cream-canvas);
  }

  dl {
    display: grid;
    gap: 8px;
    margin: 12px 0 0;
  }

  dl div {
    display: grid;
    grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
    gap: 12px;
  }

  dt,
  dd {
    margin: 0;
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
  }

  dt {
    color: var(--color-ink-black);
    font-weight: var(--font-weight-medium);
  }

  dd {
    color: var(--color-body-brown);
  }

  dd a {
    color: var(--color-link-blue);
  }

  @media (min-width: 900px) {
    .section {
      padding-block: 104px;
    }

    .section-head {
      margin-bottom: 48px;
    }

    .feature {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 24px;
      align-items: stretch;
    }
  }
</style>
