---
import Container from './ui/Container.astro';
import Pill from './ui/Pill.astro';
import SectionLabel from './ui/SectionLabel.astro';
import type { LabProject } from '../data/labs';

interface Props {
  projects: LabProject[];
  id?: string;
  title?: string;
  title2?: string;
  lede?: string;
  href?: string;
  action?: string;
}

const {
  projects,
  id = 'labs',
  title = 'Released work,',
  title2 = ' in one place.',
  lede = 'Released projects from QNR Labs. Open the full list to browse every entry.',
  href = '/labs',
  action = 'View projects',
} = Astro.props;

const featured = projects.find((project) => project.status === 'Released') ?? projects[0];

const isConfirmedUrl = (value: string) =>
  value.trim().length > 0 && !value.trim().startsWith('[TBD');

const titleId = `${id}-title`;
const projectTitleId = `${id}-project-title`;
---

<section id={id} class="section" aria-labelledby={titleId}>
  <Container>
    <header class="section-intro section-intro--center section-intro--spaced">
      <SectionLabel label="Digital Labs" />
      <h2 id={titleId} class="title-heading">{title}<span class="accent">{title2}</span></h2>
      <p class="title-subheading">{lede}</p>
    </header>

    {
      featured ? (
        <div class="feature">
          <div class="preview">
            <img src="/brand/mark.svg" alt="" width="120" height="108" />
            <p class="text-content">[TBD] Screenshot</p>
          </div>

          <ul class="rows">
            <li>
              <div>
                <p class="text-caption">Product description</p>
                <p class="text-content">{featured.summary}</p>
              </div>
            </li>
            <li>
              <div>
                <p class="text-caption">The Problem</p>
                <p class="text-content">[TBD — problem story]</p>
              </div>
            </li>
            <li>
              <div>
                <p class="text-caption">The Solution</p>
                <p class="text-content">[TBD — solution story]</p>
              </div>
            </li>
            <li class="details">
              <div>
                <p class="text-caption">Project details</p>
                <dl>
                  <div>
                    <dt>Category</dt>
                    <dd class="text-content">[TBD]</dd>
                  </div>
                  <div>
                    <dt>Technology</dt>
                    <dd class="text-content">[TBD]</dd>
                  </div>
                  <div>
                    <dt>License</dt>
                    <dd class="text-content">[TBD]</dd>
                  </div>
                  <div>
                    <dt>Live demo</dt>
                    <dd class="text-content">
                      {
                        isConfirmedUrl(featured.install) ? (
                          <a href={featured.install}>Install</a>
                        ) : (
                          featured.install
                        )
                      }
                    </dd>
                  </div>
                  <div>
                    <dt>GitHub</dt>
                    <dd class="text-content">[TBD]</dd>
                  </div>
                  <div>
                    <dt>Release date</dt>
                    <dd class="text-content">{featured.date}</dd>
                  </div>
                </dl>
              </div>
            </li>
            <li class="selected">
              <span class="well">
                <img src="/brand/mark.svg" alt="" width="22" height="20" />
              </span>
              <div>
                <h3 id={projectTitleId}>{featured.title}</h3>
                <p class="text-content">
                  {featured.status}
                  {featured.highlight ? ` · ${featured.highlight}` : ''}
                </p>
              </div>
            </li>
          </ul>
        </div>
      ) : null
    }

    <div class="section-actions section-actions--block">
      <Pill href={href}>{action}</Pill>
    </div>
  </Container>
</section>

<style>
  .section {
    padding-block: 80px;
    scroll-margin-top: 104px;
  }

  .section-intro {
    max-width: 28rem;
    margin-inline: auto;
  }

  .section-actions--block {
    justify-content: center;
    margin-top: 40px;
  }

  .feature {
    display: grid;
    gap: 16px;
  }

  .preview {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 16px;
    min-height: 280px;
    padding: 32px;
    background: var(--color-stone-surface);
    border-radius: var(--radius-3xl);
  }

  .preview img {
    width: 120px;
    height: auto;
  }

  .preview .text-content {
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    letter-spacing: var(--tracking-caption);
  }

  .rows {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    margin: 0;
    padding: 16px 18px;
    background: var(--surface-pure-white);
    border-radius: var(--radius-cards);
    box-shadow: var(--shadow-subtle);
  }

  .details {
    align-items: start;
  }

  .well {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: var(--surface-sand);
    color: var(--color-ink-black);
    font-size: var(--text-micro);
    font-weight: var(--font-weight-semibold);
    line-height: 1;
  }

  .label,
  h3,
  .text-content {
    margin: 0;
  }

  .label + .text-content,
  .rows li.selected h3 + .text-content {
    margin-top: 8px;
  }

  .label {
    color: var(--color-gold);
    font-size: var(--text-body);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
  }

  .details .text-content {
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    letter-spacing: var(--tracking-caption);
  }

  .rows li.selected {
    grid-template-columns: 40px minmax(0, 1fr);
    align-items: center;
    background: var(--color-heading-charcoal);
    color: var(--surface-canvas);
    box-shadow: none;
  }

  .rows li.selected .well {
    background: var(--surface-pure-white);
  }

  .rows li.selected .well img {
    width: 22px;
    height: auto;
  }

  .rows li.selected h3 {
    color: inherit;
    font-size: var(--text-body);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
  }

  .rows li.selected .text-content {
    color: color-mix(in srgb, var(--color-cream-canvas) 82%, var(--color-muted-gray));
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    letter-spacing: var(--tracking-caption);
  }

  dl {
    display: grid;
    gap: 8px;
    margin: 12px 0 0;
  }

  dl div {
    display: grid;
    grid-template-columns: minmax(0, 7.5rem) minmax(0, 1fr);
    gap: 12px;
  }

  dt,
  dd {
    margin: 0;
  }

  dt {
    color: var(--color-ink-black);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
    font-weight: var(--font-weight-medium);
  }

  dd a {
    color: var(--color-link-blue);
  }

  @media (min-width: 900px) {
    .section {
      padding-block: 104px;
    }

    .section-actions--block {
      margin-top: 48px;
    }

    .feature {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 24px;
      align-items: stretch;
    }
  }
</style>
