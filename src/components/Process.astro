---
import Container from './ui/Container.astro';
import SectionLabel from './ui/SectionLabel.astro';

interface Step {
  phase: string;
  verb: string;
  sub: string;
  mark: string;
  tone: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lede?: string;
  steps?: Step[];
}

const {
  id = 'how-we-build',
  eyebrow = 'How we build',
  title = 'Thoughtful development, from idea to release.',
  lede = 'These stages are a recommended framework—not a rigid sequence for every project.',
  steps = [
    {
      phase: 'Discover',
      verb: 'Discover',
      sub: 'Understand the problem, goals, and actual needs.',
      mark: '01',
      tone: 'sky',
    },
    {
      phase: 'Define',
      verb: 'Define',
      sub: 'Shape requirements and determine the right solution.',
      mark: '02',
      tone: 'honey',
    },
    {
      phase: 'Design',
      verb: 'Design',
      sub: 'Define the product experience and technical approach.',
      mark: '03',
      tone: 'mint',
    },
    {
      phase: 'Build',
      verb: 'Build',
      sub: 'Develop a functional and usable solution.',
      mark: '04',
      tone: 'grass',
    },
    {
      phase: 'Validate',
      verb: 'Validate',
      sub: 'Test, evaluate, and improve the result.',
      mark: '05',
      tone: 'sun',
    },
    {
      phase: 'Deliver',
      verb: 'Deliver',
      sub: 'Release the product and communicate its outcome.',
      mark: '06',
      tone: 'coral',
    },
  ],
} = Astro.props;

const titleId = `${id}-title`;
---

<section id={id} class="process" aria-labelledby={titleId}>
  <Container>
    <div class="intro">
      <SectionLabel label={eyebrow} />
      <h2 id={titleId}>{title}</h2>
      <p class="lede">{lede}</p>
    </div>
    <div class="diagram">
      <div class="track" aria-hidden="true"></div>
      <ol class="steps">
        {
          steps.map((step) => (
            <li class:list={['step', step.tone]}>
              <span class="phase">{step.phase}</span>
              <div class="node">
                <span class="verb">{step.verb}</span>
                <span class="sub">{step.sub}</span>
              </div>
              <span class="mark">{step.mark}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</section>

<style>
  .process {
    padding-block: 80px;
    scroll-margin-top: 104px;
  }

  .intro {
    text-align: center;
  }

  h2 {
    margin: 0 auto;
    max-width: 20ch;
    color: var(--color-ink-black);
    text-align: center;
    font-size: var(--text-heading-lg);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-heading-lg);
    letter-spacing: var(--tracking-heading-lg);
    text-wrap: balance;
  }

  .lede {
    margin: 20px auto 0;
    max-width: 42ch;
    color: var(--color-body-brown);
    text-align: center;
    font-size: var(--text-body);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
    text-wrap: pretty;
  }

  .diagram {
    position: relative;
    margin-top: 40px;
    padding: var(--card-padding) 20px;
    background: var(--color-stone-surface);
    border-radius: var(--radius-3xl);
    box-shadow: var(--shadow-subtle);
  }

  .track {
    display: none;
  }

  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    min-width: 0;
    text-align: center;
  }

  .phase {
    color: var(--color-body-brown);
    font-size: var(--text-micro);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .node {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    width: 100%;
    max-width: 132px;
    min-height: 72px;
    padding: 12px 10px;
    background: var(--tone);
    border-radius: var(--radius-cards);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink-black) 12%, transparent);
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sun {
    --tone: var(--color-sun-yellow);
  }

  .honey {
    --tone: var(--color-honey);
  }

  .sky {
    --tone: var(--color-sky-blue);
  }

  .grass {
    --tone: var(--color-grass-green);
  }

  .mint {
    --tone: var(--color-mint);
  }

  .coral {
    --tone: var(--color-coral-pink);
  }

  .verb,
  .sub,
  .mark {
    display: block;
  }

  .verb,
  .sub {
    color: var(--color-ink-black);
  }

  .verb {
    font-size: var(--text-caption);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-caption);
    letter-spacing: var(--tracking-caption);
  }

  .sub {
    font-size: var(--text-micro);
    line-height: var(--leading-micro);
    letter-spacing: var(--tracking-micro);
  }

  .mark {
    padding: 3px 8px;
    border-radius: var(--radius-pills);
    background: var(--surface-sand);
    color: var(--color-body-brown);
    font-size: var(--text-micro);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-micro);
    letter-spacing: var(--tracking-micro);
    box-shadow: inset 0 0 0 1px var(--color-stone-border);
  }

  @media (prefers-reduced-motion: no-preference) {
    .step:hover .node {
      transform: translateY(-2px);
    }
  }

  @media (min-width: 720px) {
    .diagram {
      padding: 36px 20px;
    }

    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px 12px;
    }
  }

  @media (min-width: 1024px) {
    .process {
      padding-block: 104px;
    }

    .diagram {
      padding: 44px 24px;
    }

    .track {
      display: block;
      position: absolute;
      top: 111px;
      left: 8%;
      right: 8%;
      height: 1px;
      background: color-mix(in srgb, var(--color-ink-black) 22%, var(--color-stone-surface));
    }

    .steps {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 12px 8px;
    }
  }
</style>
