---
import Container from './ui/Container.astro';
import SectionLabel from './ui/SectionLabel.astro';

interface Example {
  title: string;
  text: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  title2?: string;
  lede?: string;
  services?: Example[];
  disclaimer?: string;
}

const {
  id = 'services',
  eyebrow = 'Services',
  title = 'Turning your ideas into practical ',
  title2 = 'digital solutions.',
  lede = 'From early concepts to working products, QNR Labs helps turn ideas and real-world challenges into practical digital solutions through thoughtful development and iterative experimentation.',
  services = [
    { title: 'Web Development', text: 'Websites and web applications' },
    { title: 'Digital Product Development', text: 'Turning ideas into usable products' },
    { title: 'Custom Software', text: 'Software tailored to specific needs' },
    { title: 'Technical Solutions', text: 'Practical solutions to digital challenges' },
  ],
} = Astro.props;

const titleId = `${id}-title`;
---

<section id={id} class="section" aria-labelledby={titleId}>
  <Container>
    <div class="layout">
      <div class="list-panel">
        <ol class="services" aria-label="Example service categories">
          {
            services.map((example) => (
              <li>
                <h3 class="text-caption">{example.title}</h3>
                <p class="text-content">{example.text}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <header class="section-intro">
        <SectionLabel label={eyebrow} />
        <h2 id={titleId} class="title-heading">{title}<span class="accent">{title2}</span></h2>
        <p class="title-subheading">{lede}</p>
      </header>
    </div>
  </Container>
</section>

<style>
  .section {
    padding-block: 80px;
    scroll-margin-top: 104px;
  }

  .layout {
    display: grid;
    gap: 32px;
  }

  .section-intro {
    max-width: 38rem;
  }

  .section-intro .title-heading {
    max-width: 18ch;
  }

  .list-panel {
    padding: 8px var(--card-padding);
    background: var(--surface-pure-white);
    border-radius: var(--radius-cards);
    box-shadow: var(--shadow-subtle);
  }

  .services {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .services li {
    padding-block: 20px;
  }

  .services li + li {
    box-shadow: inset 0 1px 0 var(--color-stone-border);
  }

  .example-title {
    margin: 0;
    color: var(--color-grass-green);
    font-size: var(--text-heading);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .services .text-content {
    margin-top: 8px;
    max-width: 46ch;
  }

  .disclaimer {
    margin: 0;
    max-width: 52ch;
    color: var(--color-muted-gray);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-caption);
    letter-spacing: var(--tracking-caption);
  }

  @media (min-width: 900px) {
    .section {
      padding-block: 104px;
    }

    .layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 48px 72px;
      align-items: start;
    }

    .list-panel {
      grid-column: 1;
      grid-row: 1;
    }

    .section-intro {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>