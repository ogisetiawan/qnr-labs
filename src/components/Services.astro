---
import Container from './ui/Container.astro';

interface Example {
  title: string;
  text: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lede?: string;
  examples?: Example[];
  disclaimer?: string;
}

const {
  id = 'services',
  eyebrow = 'Services',
  title = 'Turning your ideas into practical digital solutions.',
  lede = 'From early concepts to working products, QNR Labs helps turn ideas and real-world challenges into practical digital solutions through thoughtful development and iterative experimentation.',
  examples = [
    { title: 'Web Development', text: 'Websites and web applications' },
    { title: 'Digital Product Development', text: 'Turning ideas into usable products' },
    { title: 'Custom Software', text: 'Software tailored to specific needs' },
    { title: 'Technical Solutions', text: 'Practical solutions to digital challenges' },
  ],
  disclaimer = 'These categories are examples, not a confirmed offer list.',
} = Astro.props;

const titleId = `${id}-title`;
const disclaimerId = `${id}-disclaimer`;
---

<section id={id} class="section" aria-labelledby={titleId}>
  <Container>
    <div class="layout">
      <header class="intro">
        <p class="eyebrow">{eyebrow}</p>
        <h2 id={titleId}>{title}</h2>
        <p class="lede">{lede}</p>
      </header>

      <div class="list-panel">
        <ol class="examples" aria-label="Example service categories">
          {
            examples.map((example) => (
              <li>
                <h3>{example.title}</h3>
                <p>{example.text}</p>
              </li>
            ))
          }
        </ol>
      </div>

      <p id={disclaimerId} class="disclaimer">
        {disclaimer}
      </p>
    </div>
  </Container>
</section>

<style>
  .section {
    padding-block: 80px;
    scroll-margin-top: 104px;
  }

  .layout {
    display: grid;
    gap: 32px;
  }

  .intro {
    max-width: 38rem;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--color-muted-gray);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    max-width: 18ch;
    color: var(--color-ink-black);
    font-size: var(--text-heading-lg);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-heading-lg);
    letter-spacing: var(--tracking-heading-lg);
    text-wrap: balance;
  }

  .lede {
    margin: 20px 0 0;
    color: var(--color-body-brown);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
    text-wrap: pretty;
  }

  .list-panel {
    padding: 8px var(--card-padding);
    background: var(--surface-pure-white);
    border-radius: var(--radius-cards);
    box-shadow: var(--shadow-subtle);
  }

  .examples {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .examples li {
    padding-block: 20px;
  }

  .examples li + li {
    box-shadow: inset 0 1px 0 var(--color-stone-border);
  }

  h3 {
    margin: 0;
    color: var(--color-ink-black);
    font-size: var(--text-heading);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .examples p {
    margin: 8px 0 0;
    max-width: 46ch;
    color: var(--color-body-brown);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    letter-spacing: var(--tracking-body);
  }

  .disclaimer {
    margin: 0;
    max-width: 52ch;
    color: var(--color-muted-gray);
    font-size: var(--text-caption);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-caption);
    letter-spacing: var(--tracking-caption);
  }

  @media (min-width: 900px) {
    .section {
      padding-block: 104px;
    }

    .layout {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 48px 72px;
      align-items: start;
    }

    .intro {
      grid-column: 1;
      grid-row: 1;
    }

    .list-panel {
      grid-column: 2;
      grid-row: 1;
    }

    .disclaimer {
      grid-column: 1 / -1;
      grid-row: 2;
      max-width: none;
      padding-top: 24px;
      box-shadow: inset 0 1px 0 var(--color-stone-border);
    }
  }
</style>