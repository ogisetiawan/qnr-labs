---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'sand';
}

const { href, variant = 'primary', class: className, ...rest } = Astro.props;
---

<a
  href={href}
  class:list={['pill', variant === 'sand' && 'pill-sand', className]}
  {...rest}
>
  <slot />
</a>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    background: var(--color-ink-black);
    color: var(--color-cream-canvas);
    text-decoration: none;
    font-size: 14px;
    font-weight: var(--font-weight-semibold);
    line-height: 20px;
    letter-spacing: -0.009em;
    padding: 10px 16px;
    border-radius: var(--radius-buttons);
  }

  .pill-sand {
    background: var(--surface-sand);
    color: var(--color-ink-black);
    box-shadow: inset 0 0 0 1px var(--color-stone-surface);
  }
</style>
