---
import HeroArt from './HeroArt.astro';
import Pill from './ui/Pill.astro';
import SectionLabel from './ui/SectionLabel.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  title,
  eyebrow = 'Digital Labs Studio',
  lede,
  primaryHref = '#labs',
  primaryLabel = 'Explore Digital Labs',
  secondaryHref = '#product-philosophy',
  secondaryLabel = 'Product Philosophy',
} = Astro.props;

const accent = 'Made for everyone';
const accentAt = title.indexOf(accent);
const titleBefore = accentAt === -1 ? title : title.slice(0, accentAt);
const titleAfter = accentAt === -1 ? '' : title.slice(accentAt + accent.length);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy section-intro section-intro--center section-intro--hero">
    <SectionLabel label={eyebrow} />
    <h1 id="hero-title" class="title-heading title-heading--display">
      {titleBefore}
      {accentAt !== -1 && <span class="accent">{accent}</span>}
      {titleAfter}
    </h1>
    {lede ? <p class="title-subheading">{lede}</p> : null}
    <div class="section-actions">
      <Pill href={primaryHref}>{primaryLabel}</Pill>
      <Pill href={secondaryHref} variant="sand">{secondaryLabel}</Pill>
    </div>
  </div>
  <HeroArt side="left" class="art art-left" />
  <HeroArt side="right" class="art art-right" />
</section>

<style>
  .hero {
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      'copy copy'
      'left right';
    align-items: center;
    column-gap: 16px;
    row-gap: 40px;
    padding: 64px 16px 72px;
    overflow: hidden;
  }

  .hero-copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-width: 0;
  }

  .hero :global(.art) {
    width: 100%;
    max-width: 210px;
    min-width: 0;
  }

  .hero :global(.art-left) {
    grid-area: left;
    justify-self: end;
  }

  .hero :global(.art-right) {
    grid-area: right;
    justify-self: start;
  }

  .hero-copy .title-heading--display {
    max-width: 14ch;
  }

  .hero-copy .title-subheading {
    max-width: 30rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * {
      animation: hero-rise 700ms var(--ease-out-expo) both;
    }

    .hero-copy > :nth-child(2) {
      animation-delay: 60ms;
    }

    .hero-copy > :nth-child(3) {
      animation-delay: 120ms;
    }

    .hero-copy > :nth-child(4) {
      animation-delay: 180ms;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 600px) minmax(0, 1fr);
      grid-template-areas: 'left copy right';
      column-gap: 24px;
      padding: 72px 0 88px;
    }

    .hero :global(.art) {
      max-width: 340px;
    }

    .hero :global(.art-left) {
      justify-self: start;
      margin-left: -24px;
    }

    .hero :global(.art-right) {
      justify-self: end;
      margin-right: -24px;
    }

  }
</style>
