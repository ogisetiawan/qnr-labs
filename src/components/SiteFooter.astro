---
import Container from './ui/Container.astro';

interface FooterLink {
  label: string;
  href?: string;
}

interface Props {
  year?: number;
  links?: FooterLink[];
  purpose?: string;
}

const {
  year = new Date().getFullYear(),
  links = [{ label: 'GitHub [TBD]' }, { label: 'Email [TBD]' }],
  purpose = 'Building useful software, tools, and digital solutions.',
} = Astro.props;
---

<footer id="contact" class="site-footer">
  <Container>
    <div class="brand-block">
      <a class="brand" href="/">
        <img src="/brand/logo.svg" alt="QNR Labs" width="148" height="34" />
      </a>
      <p class="purpose">{purpose}</p>
    </div>
    <div class="meta">
      <p>© {year} QNR Labs</p>
      <div class="meta-links">
        <img src="/brand/mark.svg" alt="" width="22" height="20" />
        <ul>
          {
            links.map((link) => (
              <li>{link.href ? <a href={link.href}>{link.label}</a> : link.label}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: 64px 40px;
    scroll-margin-top: 76px;
    color: var(--color-body-brown);
    font-size: var(--text-caption);
    line-height: var(--leading-caption);
  }

  .brand-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  .brand img {
    display: block;
    width: 148px;
    height: auto;
  }

  .purpose {
    margin: 0;
    /* max-width: 26ch; */
    text-align: center;
    text-wrap: balance;
    font-family: var(--font-inter);
    /* font-weight: 500; */
    /* font-size: var(--text-subheading); */
    line-height: var(--leading-subheading);
    letter-spacing: var(--tracking-subheading);
    color: var(--color-heading-charcoal);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 48px;
    padding-top: 28px;
    box-shadow: inset 0 1px 0 var(--color-stone-surface);
  }

  .meta p,
  .meta ul {
    margin: 0;
  }

  .meta-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .meta-links img {
    display: block;
    width: 22px;
    height: auto;
  }

  .meta ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 0;
    list-style: none;
  }

  .meta a {
    color: inherit;
  }
</style>
