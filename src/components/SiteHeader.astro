---
import Container from './ui/Container.astro';
import Pill from './ui/Pill.astro';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links?: NavLink[];
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  links = [
    { href: '/#how-we-build', label: 'How We Build' },
    { href: '/#labs', label: 'Digital Labs' },
    { href: '/#services', label: 'Services' },
    { href: '/about', label: 'About' },
  ],
  ctaHref = '/#contact',
  ctaLabel = 'Contact',
} = Astro.props;
---

<div class="scroll-sentinel" aria-hidden="true"></div>
<header class="site-header">
  <Container class="bar">
    <a class="brand" href="/">
      <img src="/brand/logo.svg" alt="QNR Digital Labs" width="148" height="34" />
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </nav>
    <div class="actions">
      <Pill href={ctaHref}>{ctaLabel}</Pill>
    </div>
  </Container>
</header>

<script>
  const header = document.querySelector('.site-header');
  const sentinel = header?.previousElementSibling;
  if (
    header instanceof HTMLElement &&
    sentinel instanceof HTMLElement &&
    !CSS.supports('container-type', 'scroll-state')
  ) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-stuck', !entry.isIntersecting);
    }).observe(sentinel);
  }
</script>

<style>
  .scroll-sentinel {
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: transparent;
    container-type: scroll-state;
    container-name: site-header;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 10px 0;
    border-radius: var(--radius-pills);
    background: transparent;
    box-shadow: none;
    transform: translateY(0);
    transition:
      background-color 220ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 220ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      padding 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @container site-header scroll-state(stuck: top) {
    .bar {
      transform: translateY(10px);
      padding-inline: 20px;
      background: var(--surface-pure-white);
      box-shadow:
        0 0 0 1px rgba(41, 45, 50, 0.08),
        0 8px 24px rgba(41, 45, 50, 0.12);
    }
  }

  .site-header.is-stuck .bar {
    transform: translateY(10px);
    padding-inline: 20px;
    background: var(--surface-pure-white);
    box-shadow:
      0 0 0 1px rgba(41, 45, 50, 0.08),
      0 8px 24px rgba(41, 45, 50, 0.12);
  }

  @media (prefers-reduced-motion: reduce) {
    .bar {
      transition: none;
    }
  }

  .brand {
    display: flex;
  }

  .brand img {
    display: block;
    width: 132px;
    height: auto;
  }

  .nav {
    display: flex;
    gap: 4px;
  }

  .nav a {
    color: var(--color-heading-charcoal);
    text-decoration: none;
    font-size: 16px;
    line-height: 22px;
    padding: 8px 12px;
    border-radius: var(--radius-buttons);
  }

  .nav a:hover {
    background: var(--color-stone-surface);
  }

  .actions {
    display: none;
  }

  @media (min-width: 900px) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .actions {
      display: flex;
      justify-content: flex-end;
    }
  }
</style>
