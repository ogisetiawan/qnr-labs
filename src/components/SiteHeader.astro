---
import Container from './ui/Container.astro';
import Pill from './ui/Pill.astro';

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links?: NavLink[];
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  links = [
    { href: '#work', label: 'Work' },
    { href: '#contact', label: 'Contact' },
  ],
  ctaHref = '#work',
  ctaLabel = 'Explore work',
} = Astro.props;
---

<div class="scroll-sentinel" aria-hidden="true"></div>
<header class="site-header">
  <Container class="bar">
    <a class="brand" href="/">
      <img src="/brand/logo.svg" alt="QNR Labs" width="148" height="34" />
    </a>
    <nav class="nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </nav>
    <div class="actions">
      <Pill href={ctaHref}>{ctaLabel}</Pill>
    </div>
  </Container>
  <div class="scroll-edge" aria-hidden="true"></div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const sentinel = header?.previousElementSibling;
  if (
    header instanceof HTMLElement &&
    sentinel instanceof HTMLElement &&
    !CSS.supports('container-type', 'scroll-state')
  ) {
    new IntersectionObserver(([entry]) => {
      header.classList.toggle('is-stuck', !entry.isIntersecting);
    }).observe(sentinel);
  }
</script>

<style>
  .scroll-sentinel {
    height: 1px;
    margin-bottom: -1px;
    pointer-events: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-cream-canvas);
    container-type: scroll-state;
    container-name: site-header;
  }

  .scroll-edge {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--color-stone-surface);
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @container site-header scroll-state(stuck: top) {
    .scroll-edge {
      opacity: 1;
    }
  }

  .site-header.is-stuck .scroll-edge {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-edge {
      transition: none;
    }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 76px;
  }

  .brand {
    display: flex;
  }

  .brand img {
    display: block;
    width: 132px;
    height: auto;
  }

  .nav {
    display: flex;
    gap: 4px;
  }

  .nav a {
    color: var(--color-heading-charcoal);
    text-decoration: none;
    font-size: 14px;
    line-height: 22px;
    padding: 8px 12px;
    border-radius: var(--radius-buttons);
  }

  .nav a:hover {
    background: var(--color-stone-surface);
  }

  .actions {
    display: none;
  }

  @media (min-width: 900px) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .actions {
      display: flex;
      justify-content: flex-end;
    }
  }
</style>
